NEXT_PUBLIC_API_URL=http://localhost:5500/graphql

# Optional: the API as reached from this server (internal address), when it differs from the
# public one above. Used by the gate (proxy.ts, see lib/access.ts).
# API_URL=http://api:5500/graphql

# Optional: "Sign in with Google" button on the login, signup and invite pages. The OAuth client
# ID from Google Cloud (APIs & Services → Credentials → OAuth client ID, Web application; authorized
# JavaScript origins = this app's addresses, e.g. https://musabaqa.bi and http://localhost:3001).
# The API needs the same ID in GOOGLE_CLIENT_ID. Without it the pages only have the password form.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
